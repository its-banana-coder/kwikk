# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kwikk

# ── Vision — powers auto-description/tagging for uploaded image assets ────────
# OpenAI-compatible provider. Any of these work: OpenAI, OpenRouter, Qwen/DashScope,
# Groq, local Ollama, etc.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
# VISION_MODEL overrides the model used for image description (defaults to gpt-4o-mini).
# Must support image inputs (gpt-4o-mini, qwen-vl-plus, llama-3.2-11b-vision-preview).
# VISION_MODEL=gpt-4o-mini

# ── Embeddings — semantic search over fonts/backgrounds/templates/animations ──
# Falls back to LLM_* vars if not set — one key works for both.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536   (change if using a model with different output dimensions)

# Qwen embeddings
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3

# Local via Ollama
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMS=768

# ── Data ──────────────────────────────────────────────────────────────────────
# KWIKK_DATA_DIR=./data   (default — relative to apps/api/)

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required to call POST /v1/admin/reembed (re-generate embeddings for all catalog tables).
# Set to a random secret string. curl -H "Authorization: Bearer $ADMIN_TOKEN" ...
ADMIN_TOKEN=change-me-in-production

# ── Export pipeline ───────────────────────────────────────────────────────────
# URL of the running renderer app (apps/renderer) used for headless MP4 export.
# In dev: start the renderer with `pnpm dev` (runs on :5174 by default).
# In prod: deploy apps/renderer and point this at its URL.
# First-time setup: run `npx puppeteer browsers install chrome` to download Chromium.
# Also requires ffmpeg on PATH: sudo apt install ffmpeg
RENDERER_URL=http://localhost:5174

# ── External asset sources ────────────────────────────────────────────────────
# Pixabay — free stock photos, videos, and music. Get a key at pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key
